# Frontend API.
# Local: use Vite proxy → API server (see vite.config.ts). Prefer /api/v1.
# Vercel: set VITE_API_BASE_URL=/api/v1 and DJANGO_API_ORIGIN in the project env.
VITE_API_BASE_URL=/api/v1
# VITE_API_BASE_URL=https://api.salamafarm.com/api/v1
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Local dev: point the Vite /api proxy at your machine (see vite.config.ts). Production: https://api.salamafarm.com
DJANGO_API_ORIGIN=http://127.0.0.1:8000
# DJANGO_API_ORIGIN=https://api.salamafarm.com

# Production (e.g. Vercel): VITE_API_BASE_URL=/api/v1 and DJANGO_API_ORIGIN=https://api.salamafarm.com

# R2 credentials live in backend/.env (see backend/.env.example); never put secrets here.
