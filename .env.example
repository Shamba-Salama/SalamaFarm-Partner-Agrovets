# Frontend API.
# Browser requests use the same-origin Vite/Nitro proxy by default.
# Vercel: set VITE_API_BASE_URL=/api/v1 and DJANGO_API_ORIGIN in project env.
VITE_API_BASE_URL=/api/v1
# Direct API access (for static hosting) can use:
# VITE_API_BASE_URL=https://api-next.salamafarm.com/api/v1
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Override the proxy target to use a local Django backend:
# DJANGO_API_ORIGIN=http://127.0.0.1:8000

# Production (e.g. Vercel): VITE_API_BASE_URL=/api/v1 and
# DJANGO_API_ORIGIN=https://api-next.salamafarm.com

# R2 credentials live in backend/.env (see backend/.env.example); never put secrets here.
