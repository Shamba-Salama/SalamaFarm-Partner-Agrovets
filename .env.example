# Frontend API.
# Local: use Vite proxy → Render (see vite.config.ts). Prefer /api/v1.
# Vercel: set VITE_API_BASE_URL=/api/v1 and DJANGO_API_ORIGIN in the project env.
VITE_API_BASE_URL=/api/v1
# VITE_API_BASE_URL=https://salamafarm-partner-agrovets.onrender.com/api/v1
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_USE_SUPABASE=false
DJANGO_API_ORIGIN=https://salamafarm-partner-agrovets.onrender.com
