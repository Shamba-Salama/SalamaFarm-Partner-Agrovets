# Frontend API. `.env.local` is gitignored (local only).
# Production: Vercel serves the UI over HTTPS and proxies /api to Django
# (see .env.production + vite.config.ts routeRules). Do not point Vercel
# at http://IP:8000 from the browser — mixed content will block it.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_USE_SUPABASE=false
