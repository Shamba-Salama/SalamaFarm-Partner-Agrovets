# Docker Environment Variables
# Copy this file to .env and fill in your actual values

# Database
POSTGRES_PASSWORD=changeme123

# Django Backend
SECRET_KEY=change-me-to-a-long-random-string-in-production-use-at-least-50-chars
DEBUG=False

# Paystack Kenya (get from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# SMS (Africa's Talking - optional, leave blank for console logging in dev)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Frontend API URL (used during build)
VITE_API_BASE_URL=http://localhost:8000/api/v1