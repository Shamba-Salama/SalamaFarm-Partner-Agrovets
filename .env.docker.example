# Docker Environment Variables
# Copy this file to .env and fill in your actual values

# Database
POSTGRES_PASSWORD=changeme123

# Django Backend
SECRET_KEY=change-me-to-a-long-random-string-in-production-use-at-least-50-chars
DEBUG=False

# Password reset email. Console backend prints the message in the backend logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SalamaFarm <noreply@salamafarm.com>
PORTAL_ORIGIN=http://localhost:3000

# SMS (Africa's Talking - optional, leave blank for console logging in dev)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Frontend API URL (used during build)
VITE_API_BASE_URL=https://api-next.salamafarm.com/api/v1