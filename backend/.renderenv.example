# Copy this to Render environment variables
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.salamafarm.com,*.onrender.com
DATABASE_URL=postgres://salamafarm_app:CHANGE_ME@db:5432/salamafarm
# Comma-separated browser origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-frontend.vercel.app
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
OTP_DEV_MODE=True
