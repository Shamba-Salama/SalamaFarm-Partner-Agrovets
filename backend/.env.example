# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.salamafarm.com
# ALLOWED_HOSTS=localhost,127.0.0.1,34.255.196.223
# DATABASE_URL=sqlite:///db.sqlite3

# Production CORS (comma-separated). Dev origins are fixed in settings/dev.py.
# Include the Vercel frontend origin or browsers will block API calls.
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:8080
# SECURE_SSL_REDIRECT=true behind HTTPS reverse proxy (production).
# SECURE_SSL_REDIRECT=False
# Old EC2 note:
# SECURE_SSL_REDIRECT=False
# ALLOWED_HOSTS=localhost,127.0.0.1,34.255.196.223

# Password reset email. Console backend prints the message locally.
# Set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend and fill SMTP to send real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SalamaFarm <noreply@salamafarm.com>
# Origin of the vendor portal, used in reset links.
PORTAL_ORIGIN=http://localhost:8080
# DATABASE_URL=postgres://salamafarm_app:CHANGE_ME@localhost:5432/salamafarm

# Cloudflare R2 — only required for POST /api/upload-url/ (migrations run without it)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for objects (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=
# Comma-separated portal origins for R2 bucket CORS (then: python manage.py configure_r2_cors)
# R2_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-portal.vercel.app

# Customer phone auth — Africa's Talking SMS (mobile app)
# Leave AFRICASTALKING_API_KEY blank locally: OTPs are logged to the console
# instead of sent (no SMS cost, no credentials needed for dev/testing).
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Optional overrides (defaults shown)
# OTP_DEV_MODE=False          # force console-log OTPs even if an API key is set
# OTP_TTL_SECONDS=300         # OTP lifetime (5 min)
# OTP_MAX_ATTEMPTS=5          # wrong tries before the code locks (recover via request-otp)
# OTP_REQUEST_THROTTLE=5/hour # per-phone cap on request-otp
# OTP_VERIFY_THROTTLE=10/hour # per-phone cap on verify-otp
