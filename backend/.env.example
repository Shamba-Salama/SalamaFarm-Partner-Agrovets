# Production CORS (comma-separated). Dev origins are fixed in settings/dev.py.
# Include the Vercel frontend origin or browsers will block API calls.
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:8080

# Paystack Kenya (leave blank here — set real test keys in your local .env)
PAYSTACK_SECRET_KEY=sk_test_b489529988c19f9682e2e5d52e5481f437281c03
PAYSTACK_PUBLIC_KEY=pk_test_ba9509207deff18f9dfb99ef2cd6e5be2afcb020
