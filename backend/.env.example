# DATABASE_URL=postgres://salamafarm_app:CHANGE_ME@localhost:5432/salamafarm

# Customer phone auth — Africa's Talking SMS (mobile app)
# Leave AFRICASTALKING_API_KEY blank locally: OTPs are logged to the console
# instead of sent (no SMS cost, no credentials needed for dev/testing).
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Optional overrides (defaults shown)
# OTP_DEV_MODE=False          # force console-log OTPs even if an API key is set
# OTP_TTL_SECONDS=300         # OTP lifetime (5 min)
# OTP_MAX_ATTEMPTS=5          # wrong tries before the code locks (recover via request-otp)
# OTP_REQUEST_THROTTLE=5/hour # per-phone cap on request-otp
# OTP_VERIFY_THROTTLE=10/hour # per-phone cap on verify-otp
