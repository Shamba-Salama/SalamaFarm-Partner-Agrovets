# ──────────────────────────────────────────────────────────────────────────────
# SalamaFarm Partner Agrovets — React frontend (Vite/TanStack Start)
# Multi-stage build: Node 22 (build) → Node 22 (runtime, Nitro server)
#
# Render's default Dockerfile is the Django API at ./Dockerfile.
# Use this file for the portal image (docker-compose / GHCR).
# ──────────────────────────────────────────────────────────────────────────────

FROM node:22-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --no-audit

COPY . .

ARG VITE_API_BASE_URL=https://api-next.salamafarm.com/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV NITRO_TARGET=node

RUN npm run build

FROM node:22-slim

WORKDIR /app
COPY --from=build /app/.output ./.output

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=80

EXPOSE 80

CMD ["node", ".output/server/index.mjs"]